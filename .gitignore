# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 템플릿은 커밋한다. 어떤 환경변수가 필요한지 알 방법이 이것뿐이다.
!.env.local.example

# 사장님이 주신 메뉴 원본 (엑셀 + 사진)
#
# 사진은 여기서 Supabase Storage 로 올라간다. 저장소에 두면 용량만 커지고,
# 원본은 사장님 쪽에도 있으므로 여기서 잃어버릴 것도 없다.
# 엑셀도 한 번 읽어 DB 에 넣으면 되는 입력 자료라 이력을 남길 이유가 없다.
/menu-import

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
