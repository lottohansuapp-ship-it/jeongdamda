# Supabase — Project Settings > API
# anon(publishable) 키는 공개용이다. RLS가 보호한다.
# service_role 키는 이 파일에도, .env.local 에도 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 배포 후 실제 도메인. 메타데이터/OG/sitemap 절대 URL 생성에 쓴다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 로그인 (D16) — 개발자센터 앱 + Supabase Provider 준비되면 1
NEXT_PUBLIC_KAKAO_LOGIN_ENABLED=0

# ── 결제 (포트원 V2) ────────────────────────────────────────────────
# 다섯 개가 전부 있어야 결제창이 뜬다. 하나라도 비면 주문만 접수되고 결제는 건너뛴다.
#
# 아래 둘은 브라우저로 나간다. 공개돼도 안전하다 —
# 금액 위조는 서버가 포트원 API 로 결제를 다시 조회해서 막는다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# 결제수단마다 채널이 다르다. 카카오페이는 그 자체가 결제대행사라
# 카드용 채널로는 못 부른다 — 포트원 콘솔에서 채널을 따로 만들어야 한다.
# 비워 두면 그 수단은 주문서에 안 나온다. 계약한 것만 보이게 하려는 것이다.
# 카드와 휴대폰을 같은 PG 사로 계약했다면 아래 MOBILE 에 위와 같은 값을 넣는다.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KAKAOPAY=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_MOBILE=

# 아래 셋은 서버 전용이다. NEXT_PUBLIC_ 을 붙이면 브라우저로 새어나간다.
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# 웹훅이 "이 주문을 결제됨으로 표시" 딱 하나만 할 수 있게 하는 좁은 비밀값이다.
# 웹훅에는 로그인 세션이 없어 권한이 필요한데, 여기에 service_role 키를 쓰면
# 그 키 하나가 새는 순간 손님 주소·연락처까지 전부 털린다. 그래서 쓰지 않는다.
# (맨 위의 "service_role 키는 절대 넣지 않는다" 규칙은 그대로 유효하다.)
#
# 32바이트 이상 난수를 만들어 여기와 DB 양쪽에 같은 값을 넣는다:
#   openssl rand -base64 32
#   insert into public.app_secrets (key, value) values ('payment_webhook', '<그 값>');
PAYMENT_WEBHOOK_SECRET=

# ── 알림톡 (v2-F) ──────────────────────────────────────────────────
# 대행사(솔라피/알리고/NHN 등) 계약 + 카카오 비즈니스 채널 + 템플릿 사전승인이
# 끝나면 채운다. 비어 있으면 알림을 보내지 않고 notification_logs 에 기록만 남긴다.
# 대행사가 정해지면 고칠 코드는 src/lib/notify/alimtalk.ts 하나다.
ALIMTALK_ENDPOINT=
ALIMTALK_API_KEY=
ALIMTALK_SENDER_KEY=
ALIMTALK_TEMPLATE_CODE=
